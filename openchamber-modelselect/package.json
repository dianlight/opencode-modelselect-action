{
  "name": "openchamber-modelselect",
  "version": "0.1.1",
  "description": "Work Status section surfacing the modelselect plugin's per-session pick plus its on/off/auto mode switch.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openchamber/sdk": "2.0.2"
  },
  "scripts": {
    "build": "openchamber-guest-bundle status/src/main.js status/main.js",
    "check": "node --check status/main.js",
    "test": "node --test test/"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "contributes": {
      "panel": {
        "id": "model-select",
        "name": "Model select",
        "icon": "window"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Model select",
        "height": 120
      },
      "capabilities": [
        "files"
      ],
      "filesystem": [
        "~/.config/opencode/opencode.json",
        "~/.config/opencode/opencode.jsonc",
        "~/.config/openchamber/opencode.managed.json",
        "~/.config/openchamber/routing.json"
      ]
    }
  }
}
