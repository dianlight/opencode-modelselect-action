{
  "name": "openchamber-modelselect",
  "version": "0.7.0",
  "description": "Host-rendered Work Status section (contributes.statusSection.source) surfacing the modelselect plugin's project pick plus the auto-update-router switch, and a settings panel for the plugin options and the extension config.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openchamber/sdk": "2.6.2-canary.20261106.9"
  },
  "scripts": {
    "build": "openchamber-guest-bundle --node service/src/main.js service/main.js && openchamber-guest-bundle panel/src/main.js panel/main.js",
    "check": "node --check service/main.js && node --check panel/main.js",
    "test": "node --test test/"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.6.2"
    },
    "contributes": {
      "panel": {
        "id": "model-select",
        "name": "Model select",
        "icon": "window",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "source": {
          "path": "/status",
          "interval": 2000
        },
        "title": "Model select"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": ["quota"]
      },
      "quota": {
        "providers": []
      },
      "capabilities": [
        "files"
      ],
      "filesystem": [
        "~/.config/opencode/opencode.json",
        "~/.config/opencode/opencode.jsonc",
        "~/.config/openchamber/opencode.managed.json",
        "~/.config/openchamber/routing.json",
        "~/.config/openchamber/modelselect.json",
        "~/.config/openchamber/settings.json",
        "~/.config/openchamber/preferences.json"
      ]
    }
  }
}
